# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SOLO servidor. Nunca con prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Secreto que Vercel Cron envia como Authorization: Bearer <valor>
CRON_SECRET=

# Zona horaria por defecto para el calculo de horas habiles
DEFAULT_TIMEZONE=America/Chihuahua
